# === OpenRouter (AI) ===
# Wajib — ambil API key gratis di https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opsional — pilih model spesifik. Default: "openrouter/free" (pilih model gratis otomatis).
# Contoh:
#   openrouter/free
#   google/gemini-2.0-flash-exp:free
#   meta-llama/llama-3.3-70b-instruct:free
#   anthropic/claude-3.5-sonnet   (berbayar)
OPENROUTER_MODEL=

# Opsional — muncul di dashboard analytics OpenRouter
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Soalin

# === Autentikasi ===
# Wajib — secret untuk sign JWT. Bebas, minimal 32 karakter, random.
# Generate cepat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Wajib — kredensial admin (kamu). Pakai untuk akses /admin-secret-panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# === Supabase (WAJIB untuk login user) ===
# Dari Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WAJIB — service_role key (bypass RLS, jangan di-expose ke client!)
# Ambil dari Project Settings → API → "service_role" key (di bawah anon key)
SUPABASE_SERVICE_ROLE_KEY=
